        },
        comment,
        lightbox: theme.mediumZoom ? "mediumZoom" : (theme.fancybox ? "fancybox" : null),
        right_menu: rightMenu,
        translate,
        lure,
        expire
    };

template#site-config!= JSON.stringify(globalConfig).replace(/</g, '\\u003c')
